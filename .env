# =============================================================================
# mem0-demo 智能客服系统 - 环境变量配置
# =============================================================================
# 使用方法:
#   1. 复制 .env.example 为 .env
#   2. 填入真实的 API Key
#   3. 切勿将 .env 提交到 Git（已在 .gitignore 中排除）
# =============================================================================

# ----- DashScope / Qwen 配置（必填）-----

# DashScope API Key（阿里云，用于 LLM + Embedding）
DASHSCOPE_API_KEY=sk-00000000000000000000000000000000

# Qwen 模型名称
QWEN_MODEL=qwen-plus

# Embedding 模型
QWEN_EMBEDDING_MODEL=text-embedding-v3

# ----- 服务配置 -----

# 服务监听端口
APP_PORT=8000

# 服务监听地址（0.0.0.0 表示监听所有网卡）
APP_HOST=0.0.0.0

# 调试模式
DEBUG=true

# ----- RAG 配置 -----

# 是否使用 Chroma 向量数据库
USE_CHROMA=true

# RAG 检索返回结果数量
RAG_TOP_K=5

# RAG 相似度阈值（0~1，越高越严格）
RAG_SCORE_THRESHOLD=0.55

# ----- mem0 记忆配置 -----

# 记忆检索 Top-K
MEM0_TOP_K=5

# 记忆相似度阈值
MEM0_SCORE_THRESHOLD=0.3

# 记忆提取策略（customer_service | general | strict）
MEM0_MEMORY_STRATEGY=customer_service

# ----- 缓存配置 -----

# 缓存 TTL（秒）
CACHE_TTL=3600

# 语义缓存阈值
CACHE_SEMANTIC_THRESHOLD=0.92

# ----- Telegram Bot -----
# TELEGRAM_BOT_TOKEN=

# ----- ChromaDB 持久化路径（可选）-----
# CHROMA_PERSIST_PATH=./data/chroma_db
