# =============================================================================
# PayCrypto API 智能客服系统 - 环境变量配置模板
# =============================================================================
# 使用方法:
#   1. 复制此文件为 .env
#   2. 填入真实的 API Key
#   3. 切勿将 .env 提交到 Git（已在 .gitignore 中排除）
# =============================================================================

# ----- AI 提供商配置 -----

# 默认 AI 提供商 (openai / deepseek / siliconflow / custom)
DEFAULT_AI_PROVIDER=deepseek

# OpenAI API Key（如使用 OpenAI）
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE

# DeepSeek API Key（如使用 DeepSeek）
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_API_KEY_HERE

# 硅基流动 API Key（如使用 SiliconFlow）
SILICONFLOW_API_KEY=YOUR_SILICONFLOW_API_KEY_HERE

# 智谱 GLM API Key（如使用智谱）
ZHIPU_API_KEY=YOUR_ZHIPU_API_KEY_HERE

# ----- 服务配置 -----

# 服务监听端口
PORT=8000

# 服务监听地址（0.0.0.0 表示监听所有网卡）
HOST=0.0.0.0

# 日志级别 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# ----- RAG 配置 -----

# 是否使用 Chroma 向量数据库
USE_CHROMA=false

# RAG 检索返回结果数量
RAG_TOP_K=10

# RAG 相似度阈值
RAG_SCORE_THRESHOLD=3.0

# ----- 会话记忆配置 -----

# 内存存储路径（相对路径或绝对路径）
MEMORY_DIR=./memory_store.json

# 最大会话历史轮数
MAX_HISTORY=20

# 是否启用会话记忆
MEMORY_ENABLED=true

# ----- 文档配置 -----

# 文档缓存目录
DOCS_CACHE_DIR=./docs_cache

# Obsidian 笔记仓库路径（如使用 Obsidian 集成）
OBSIDIAN_VAULT_DIR=./obsidian_vault

# ----- 安全配置 -----

# API 请求速率限制（请求/分钟）
RATE_LIMIT_PER_MINUTE=60

# 允许的来源域名（CORS，逗号分隔）
ALLOWED_ORIGINS=*
